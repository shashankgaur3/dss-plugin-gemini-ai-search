/* This file is the descriptor for custom agent tool vertex-ai-web-search-tool */
{
    "meta" : {
        // label: name of the agent tool as displayed, should be short
        "label": "Vertex AI web search",

        // description: longer string to help end users understand what this agent tool does.
        "description": "Answers public-web questions with Gemini using Google Search grounding and a Dataiku Vertex AI connection.",

        // icon: must be one of the FontAwesome 5.15.4 icons, complete list here at https://fontawesome.com/v5/search?ic=free-collection
        "icon": "fas fa-search"
    },

    /* params:
    DSS will generate a form from this list of requested parameters.
    Your component code can then access the value provided by users using the "name" field of each parameter.

    Available parameter types include:
    STRING, INT, DOUBLE, BOOLEAN, DATE, SELECT, TEXTAREA, PRESET and others.

    Warning: COLUMN_VALUE and COLUMN_VALUES are supported in Dataiku Apps, but not in plugins.

    For the full list and for more details, see the documentation: https://doc.dataiku.com/dss/latest/plugins/reference/params.html
    */
    "params": [
        {"name": "vertex_connection", "label": "Dataiku Vertex AI connection", "type": "CONNECTION", "mandatory": true, "searchable": true, "description": "Dataiku Google/Vertex connection. KEYPAIR and OAUTH authentication are supported."},
        {"name": "gcp_project_id", "label": "Google Cloud project ID override", "type": "STRING", "mandatory": false, "description": "Optional. Uses the selected connection's projectId when left blank."},
        {"name": "location", "label": "Vertex AI location override", "type": "STRING", "mandatory": false, "description": "Optional. Uses the selected connection's location or region when left blank."},
        {"name": "model", "label": "Gemini model", "type": "STRING", "mandatory": false, "defaultValue": "gemini-2.5-flash", "description": "Vertex AI Gemini model that supports Google Search grounding."},
        {"name": "temperature", "label": "Temperature", "type": "DOUBLE", "mandatory": false, "defaultValue": 0.3, "minD": 0, "maxD": 2, "description": "Generation temperature."}
    ]
}
